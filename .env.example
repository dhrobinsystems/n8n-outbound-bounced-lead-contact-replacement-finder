# n8n-outbound-bounced-lead-contact-replacement-finder
# Copy to .env for the local mirror CLI, and set the same names as environment
# variables on your n8n host (n8n reads them through $env).
# Values shaped like YOUR_..._HERE are treated as unset by the workflow.

# ---------- Safety flags (writes happen only when BOTH are false) ----------
DRY_RUN=true
SANDBOX_MODE=true

# ---------- n8n host setting (set on the n8n process, not read by the workflow) ----------
# Code nodes and expressions need $env access.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---------- Inbound webhook auth ----------
# Append ?token=<value> to the webhook URL you give Smartlead / Instantly,
# or send header x-webhook-token. Required whenever SANDBOX_MODE=false.
WEBHOOK_SHARED_SECRET=YOUR_WEBHOOK_SHARED_SECRET_HERE

# ---------- Sequencers ----------
SMARTLEAD_API_KEY=YOUR_SMARTLEAD_API_KEY_HERE
INSTANTLY_API_KEY=YOUR_INSTANTLY_API_KEY_HERE
# Optional: enroll replacements into this campaign instead of the bounced contact's campaign.
REPLACEMENT_CAMPAIGN_ID=

# ---------- Apollo ----------
APOLLO_API_KEY=YOUR_APOLLO_API_KEY_HERE
APOLLO_ENRICH_TOP_N=2
APOLLO_PER_PAGE=25

# ---------- HubSpot (private app access token) ----------
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_ACCESS_TOKEN_HERE

# ---------- Clay fallback (optional, async) ----------
CLAY_ENABLED=false
CLAY_WEBHOOK_URL=YOUR_CLAY_WEBHOOK_URL_HERE
CLAY_WEBHOOK_AUTH_TOKEN=YOUR_CLAY_WEBHOOK_AUTH_TOKEN_HERE
CLAY_CALLBACK_SECRET=YOUR_CLAY_CALLBACK_SECRET_HERE

# ---------- Email verification ----------
# none = trust the source status only; zerobounce = also require a ZeroBounce "valid" result
VERIFIER_PROVIDER=none
ZEROBOUNCE_API_KEY=YOUR_ZEROBOUNCE_API_KEY_HERE
ACCEPT_EMAIL_STATUSES=verified
ALLOW_CATCH_ALL=false

# ---------- Suppression and loop guards ----------
MAX_REPLACEMENTS_PER_ACCOUNT=2
REPLY_LOOKBACK_DAYS=30
MIN_MATCH_SCORE=60
BLOCKED_LIFECYCLE_STAGES=opportunity,customer,evangelist
# Comma-separated domains that must never get a replacement
SUPPRESSED_DOMAINS=
# Leave empty to use the built-in list of public mailbox providers
FREE_MAIL_DOMAINS=
# Treat a bounce with no SMTP code or reason as hard. Keep false unless you have checked your provider's payloads.
ASSUME_HARD_WHEN_UNSPECIFIED=false

# ---------- Slack audit ----------
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
SLACK_NOTIFY_IGNORED=false
SLACK_REDACT_EMAILS=false

# ---------- Local CLI only ----------
# Your n8n *test* webhook URL, used by: node mirror-cli.js send <payload>
N8N_BOUNCE_WEBHOOK_URL=YOUR_N8N_TEST_WEBHOOK_URL_HERE
